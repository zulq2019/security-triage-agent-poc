<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Per-agent host (docs/containers.md): one binary, one container image per agent. SECAGENT_AGENT picks the role module; everything
       else (queue transport, health, drain, OpenTelemetry) comes from SecAgent.Hosting. Single-process dev mode stays `secagent serve`. -->
  <PropertyGroup>
    <AssemblyName>secagent-worker</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SecAgent.Hosting/SecAgent.Hosting.csproj" />
    <ProjectReference Include="../SecAgent.Hosting.Azure/SecAgent.Hosting.Azure.csproj" />
    <ProjectReference Include="../SecAgent.Agents/SecAgent.Agents.csproj" />
    <ProjectReference Include="../SecAgent.Connectors.Hosting/SecAgent.Connectors.Hosting.csproj" />
    <ProjectReference Include="../SecAgent.Intake/SecAgent.Intake.csproj" />
    <ProjectReference Include="../SecAgent.Intake.Azure/SecAgent.Intake.Azure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SecAgent.Tests" />
  </ItemGroup>
</Project>
