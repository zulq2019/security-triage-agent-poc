{
  // Worker host defaults. Role, transport and paths come from the environment (SECAGENT_AGENT, SECAGENT_QUEUE, SECAGENT_DATA_ROOT...),
  // see docs/containers.md. Never put secrets here.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Agent": {
    "Transport": "in-process",
    "DrainTimeoutSeconds": 30,
    "MaxConcurrentMessages": 1,
    "ReceiveWaitSeconds": 5,
    "MaxDeliveries": 3
  },
  // Connectors for the roles that run the pipeline (orchestrator), same defaults as the dashboard (docs/connectors.md). The toolchain image
  // has the GitHub CLI, so "gh-cli:token" resolves GH_TOKEN; in Azure override with Connectors__Tenants__local__SourceControl__Secret=kv:...
  "Connectors": {
    "DeploymentModel": "SingleTenant",
    "DefaultTenant": "local",
    "Tenants": {
      "local": {
        "SourceControl": { "Provider": "github", "BaseUrl": "https://api.github.com/", "Secret": "gh-cli:token" },
        "IssueTracker": { "Provider": "none" },
        "ScannerSource": { "Provider": "none" },
        "Notifier": { "Provider": "none" }
      }
    }
  }
}
