{
  // Worker host defaults. Role, transport and paths come from the environment (SECAGENT_AGENT, SECAGENT_QUEUE, SECAGENT_DATA_ROOT...),
  // see docs/containers.md. Never put secrets here.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Agent": {
    "Transport": "in-process",
    "DrainTimeoutSeconds": 30,
    "MaxConcurrentMessages": 1,
    "ReceiveWaitSeconds": 5,
    "MaxDeliveries": 3
  }
}
