{
  // Model provider switch. Change "Provider" here, or set SECAGENT_MODEL_PROVIDER = ollama | openai | azureopenai.
  // API keys are NEVER put in this file: only the NAME of the environment variable that holds the key (ApiKeyEnv).
  // Personal overrides go in appsettings.Local.json next to this file (git-ignored).
  "ModelProvider": {
    "Provider": "ollama",
    // ollama only: "default" = qwen2.5:3b (small) + qwen2.5-coder:7b (strong), about 10 GB resident;
    //              "3b-only" = qwen2.5-coder:3b for both tiers, about 3 GB resident (16 GB laptops). Env: SECAGENT_LOCAL_PROFILE.
    "LocalProfile": "default",
    "Providers": {
      "ollama": {
        "BaseUrl": "http://localhost:11434/v1"
      },
      "openai": {
        "BaseUrl": "https://api.openai.com/v1",
        "ApiKeyEnv": "OPENAI_API_KEY",
        // Placeholders: set these to the current small/fast and stronger models on your account
        // (or use SECAGENT_SMALL_MODEL / SECAGENT_STRONG_MODEL).
        "SmallModel": "gpt-6-luna",
        "StrongModel": "gpt-6.1-sol",
        "ContextWindow": 128000,
        "OutputReserveTokens": 4096,
        "RunTokenBudget": 250000,
        "MaxConcurrentCalls": 4,
        "SendTemperature": false,
        "SendSeed": false,
        // Optional, used for the run cost meter only (USD per 1k tokens). Fill in from the pricing page.
        "SmallCostPer1kIn": 0, "SmallCostPer1kOut": 0, "StrongCostPer1kIn": 0, "StrongCostPer1kOut": 0
      },
      "azureopenai": {
        // Azure OpenAI v1 API (OpenAI-compatible). Model names are your DEPLOYMENT names.
        "BaseUrl": "https://<your-resource>.openai.azure.com/openai/v1/",
        "ApiKeyEnv": "AZURE_OPENAI_API_KEY",
        "SmallModel": "<small-deployment-name>",
        "StrongModel": "<strong-deployment-name>",
        "ContextWindow": 128000,
        "OutputReserveTokens": 4096,
        "RunTokenBudget": 250000,
        "MaxConcurrentCalls": 4,
        "SendTemperature": false,
        "SendSeed": false
      }
    }
  },
  // SARIF / Black Duck intake (docs/intake.md). The HMAC secret is NEVER in this file: only the NAME of the env var that holds it
  // (locally ~/.secagent/secagent.env; in Azure an App Service Key Vault reference). Unset secret = every intake request gets 503.
  "Intake": {
    "Enabled": true,
    "HmacSecretEnv": "SECAGENT_INTAKE_HMAC_SECRET",
    "TimestampToleranceSeconds": 300,
    "MaxBodyBytes": 26214400,
    "MaxResults": 20000,
    "AllowedScanners": [ "blackduck" ],
    "AllowedRepos": [],            // e.g. [ "my-org/*" ]; empty = any repo
    "DropWatcherEnabled": false,   // dev stand-in for Blob → Event Grid; or env SECAGENT_INTAKE_DROP_WATCHER=1
    "DropFolder": ""               // default .data/intake/drop
  }
}
