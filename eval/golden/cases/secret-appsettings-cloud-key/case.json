{
  "id": "secret-appsettings-cloud-key",
  "title": "Cloud access key committed in appsettings.json",
  "category": "secret_in_config",
  "description": "A cloud access key id in application configuration. Expected: replace the literal with a Key Vault reference, raise a rotation task, nothing else changes.",
  "tags": [
    "positive",
    "secret"
  ],
  "expected": {
    "triage": "fix",
    "fixer": "secrets",
    "outcome": "fixed",
    "severity_effective": "high",
    "human_tasks": [
      "rotation"
    ]
  },
  "checks": [
    {
      "type": "pattern_present",
      "file": "src/App/appsettings.json",
      "regex": "\"AccessKeyId\": \"@Microsoft\\.KeyVault\\(VaultName=kv-sample-orders-dev;SecretName=[0-9A-Za-z-]{1,127}\\)\""
    },
    {
      "type": "pattern_absent",
      "file": "src/App/appsettings.json",
      "regex": "AKIA[A-Z2-7]{16}"
    },
    {
      "type": "builds"
    },
    {
      "type": "no_new_findings"
    },
    {
      "type": "diff_allowed_files",
      "allowed": [
        "src/App/appsettings.json"
      ]
    }
  ],
  "target": {
    "rule": "secret-cloud-access-key",
    "file": "src/App/appsettings.json"
  },
  "synthetic_secrets": {
    "CLOUD_KEY": "aws_access_key_id"
  },
  "notes": "Any valid Key Vault secret name is accepted (the model chooses it); the check pins the vault reference shape, not the name."
}
