# Copy to .env at the repository root (git-ignored) for `docker compose`. Local, synthetic use only.
# SQL Server container `sa` password: 8+ chars with upper, lower, digit and symbol. Pick your own; never reuse a real one.
MSSQL_SA_PASSWORD=
# Fingerprint / evidence hashing key shared by all agents (required): openssl rand -hex 32
SECAGENT_HMAC_KEY=
# Shared HMAC secret for POST /api/intake/* (same value as the CI secret INTAKE_HMAC_SECRET). Empty = intake answers 503.
SECAGENT_INTAKE_HMAC_SECRET=
# Optional: token for real PR runs against the synthetic sample repo (gh / git push). Leave empty otherwise.
GH_TOKEN=
# Optional: model endpoint reachable from the containers (default: Ollama on the Docker host).
SECAGENT_MODEL_BASE_URL=
# Optional: OTLP collector (e.g. http://otel-collector:4317) and console span export.
OTEL_EXPORTER_OTLP_ENDPOINT=
SECAGENT_OTEL_CONSOLE=0
# Folder with synthetic git repos the scanner may scan via ScanRequest.LocalPath (mounted read-only at /samples).
SECAGENT_SAMPLES_DIR=./.data/samples
# Host ports (bound to 127.0.0.1 only). Change if 8080 / 8795 are taken on your machine.
SECAGENT_INTAKE_PORT=8080
SECAGENT_DASHBOARD_PORT=8795
