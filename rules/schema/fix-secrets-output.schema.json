{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "secagent/fix-secrets-output/1.0.0",
  "type": "object",
  "properties": {
    "secret_name": {
      "type": "string",
      "pattern": "^[0-9a-zA-Z-]{1,127}$"
    },
    "rotation_note": {
      "type": "string",
      "maxLength": 300
    },
    "reviewer_note": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "secret_name",
    "rotation_note",
    "reviewer_note"
  ],
  "additionalProperties": false
}